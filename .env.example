# LLM provider: 'anthropic' (default) or 'ollama'
LLM_PROVIDER=anthropic

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-sonnet-5

# Ollama (required when LLM_PROVIDER=ollama)
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# Agent behaviour
LOG_LEVEL=INFO
MAX_RETRY_ON_LOW_CONFIDENCE=1   # max adapter→executor retries before escalating

# Privacy / storage (MVP: storage disabled by default)
HISTORY_CONSENT=false
HISTORY_RETENTION_DAYS=7
